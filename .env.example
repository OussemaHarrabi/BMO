# BMO Environment Configuration
# Copy this file to .env and update values as needed

# =============================================================================
# Database Configuration
# =============================================================================

# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bmo_password

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Redis Event Bus
REDIS_HOST=localhost
REDIS_PORT=6379

# =============================================================================
# Ollama LLM Configuration
# =============================================================================

OLLAMA_HOST=http://localhost:11434

# Model names (must be pulled via: docker exec -it bmo-ollama ollama pull <model>)
ROUTER_MODEL=phi3.5:latest
REASONER_MODEL=qwen3:4b
CLASSIFIER_MODEL=phi3.5:latest
VERIFIER_MODEL=phi3.5:latest
VISION_MODEL=gemma3:4b-it
EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# API Configuration
# =============================================================================

API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Capture Configuration
# =============================================================================

# Watch paths for file monitoring (comma-separated)
WATCH_PATHS=${HOME}/Documents,${HOME}/Downloads,${HOME}/Projects

# Browser extension native messaging host
NATIVE_HOST_NAME=com.bmo.capture

# Email Capture
# JSON array of email accounts - example:
# EMAIL_ACCOUNTS=[{"email":"user@gmail.com","password":"app_password","imap_server":"imap.gmail.com"}]
EMAIL_ACCOUNTS=[]
EMAIL_POLL_INTERVAL=60
EMAIL_MAX_PER_POLL=50
EMAIL_PROCESS_ATTACHMENTS=true
EMAIL_MAX_BODY_LENGTH=10000

# =============================================================================
# Processing Configuration
# =============================================================================

# Maximum text length for processing
MAX_TEXT_LENGTH=10000

# Confidence thresholds
CONFIDENCE_HIGH=0.7
CONFIDENCE_LOW=0.4

# =============================================================================
# Storage Configuration
# =============================================================================

# Local data directory
BMO_DATA_DIR=./bmo_data

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# Frontend Configuration (for Next.js)
# =============================================================================

NEXT_PUBLIC_API_URL=http://localhost:8000
